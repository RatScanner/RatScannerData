root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
# Must match [tool.ruff] line-length in pyproject.toml. Without this, editors fall
# back to an 88-column default formatter and `ruff format --check` fails in CI.
line_length = 100
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false